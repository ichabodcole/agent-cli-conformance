{
  "name": "agent-cli-conformance",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A specification and conformance kit for agent-first command-line tools.",
  "scripts": {
    "prepare": "husky",
    "docs:lint": "bun docs/wiki/lint.ts",
    "docs:graph": "bun docs/wiki/lint.ts --json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write --error-on-warnings .",
    "format": "biome format --write .",
    "format:md": "prettier --write '**/*.md'",
    "check": "bun run typecheck && biome check --error-on-warnings . && bun run docs:lint && bun run test",
    "acc": "bun src/acc/cli.ts"
  },
  "lint-staged": {
    "*.{ts,json,jsonc}": [
      "biome check --error-on-warnings --no-errors-on-unmatched"
    ],
    "*.md": [
      "prettier --check"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@stricli/core": "^1.3.0",
    "@types/bun": "^1.3.14",
    "commander": "^15.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  },
  "bin": {
    "acc": "./src/acc/cli.ts"
  }
}
