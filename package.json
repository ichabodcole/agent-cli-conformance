{
  "name": "agent-cli-conformance",
  "version": "0.1.10",
  "private": true,
  "type": "module",
  "description": "A specification and conformance kit for agent-first command-line tools.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ichabodcole/agent-cli-conformance.git"
  },
  "homepage": "https://github.com/ichabodcole/agent-cli-conformance#readme",
  "scripts": {
    "hooks": "husky",
    "docs:lint": "bun docs/wiki/lint.ts",
    "docs:lint:artifacts": "bun docs/lint.ts",
    "docs:graph": "bun docs/wiki/lint.ts --json",
    "docs:sync": "bun docs/wiki/lint.ts --write && prettier --write docs/wiki/index.md",
    "docs:build": "bun docs/wiki/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write --error-on-warnings .",
    "format": "biome format --write .",
    "format:md": "prettier --write '**/*.md'",
    "format:md:check": "prettier --check '**/*.md'",
    "check": "bun run typecheck && biome check --error-on-warnings . && bun run format:md:check && bun run docs:lint && bun run docs:lint:artifacts && bun run docs:build && bun run test",
    "acc": "bun src/acc/cli.ts"
  },
  "lint-staged": {
    "*.{ts,json,jsonc}": [
      "biome check --error-on-warnings --no-errors-on-unmatched"
    ],
    "*.md": [
      "prettier --check"
    ]
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@stricli/core": "^1.3.0",
    "@types/bun": "^1.3.14",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  },
  "bin": {
    "acc": "./src/acc/cli.ts"
  }
}
